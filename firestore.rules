rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Private scan history: only the (anonymous) owner.
    match /users/{uid}/scans/{id} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Family alerts: the family code acts as a shared secret. Alerts hold no message text.
    match /families/{code}/alerts/{id} {
      allow read, create: if request.auth != null;
      allow update, delete: if false;
    }
    // Community scam patterns: signed-in users can read and add, nothing else.
    match /reports/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
